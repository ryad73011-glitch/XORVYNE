{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist/server",
    "rootDir": ".",
    "noEmit": false,
    "sourceMap": false
  },
  "include": ["server/src/**/*.ts", "shared/**/*.ts"]
}
