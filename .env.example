# Server listening port (default: 8787)
PORT=8787
HOST=0.0.0.0

# Optional local ffmpeg binary. If unset, XORVYNE checks vendor/ffmpeg/ffmpeg and PATH.
# Install the platform-appropriate binary with `npm run setup:ffmpeg`.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Maximum size of each uploaded file (default: 200 MiB)
# XORVYNE_MAX_UPLOAD_BYTES=209715200

# Local temporary directory (uploads and exports are removed after retention).
# XORVYNE_TEMP_DIR=.tmp
# XORVYNE_JOB_RETENTION_MS=1800000

# Optional OpenAI-compatible command model. Both values are required before the
# live provider is used. The key stays on the server and is never sent to the browser.
# XORVYNE_COMMAND_ENDPOINT=https://your-provider.example/v1/chat/completions
# XORVYNE_COMMAND_API_KEY=
# XORVYNE_COMMAND_MODEL=your-model-name

# Optional text-to-video REST provider. Must respond with a plan that includes
# `footageGenerated: true` only when it actually returned rendered footage.
# XORVYNE_VIDEO_ENDPOINT=https://your-provider.example/video
# XORVYNE_VIDEO_API_KEY=
# XORVYNE_VIDEO_MODEL=your-model-name

# Reserved future provider slots. No provider is called unless a compatible
# adapter is configured in server/src/providers/registry.ts.
# XORVYNE_STT_ENDPOINT=
# XORVYNE_STT_API_KEY=
# XORVYNE_TRANSLATION_ENDPOINT=
# XORVYNE_TRANSLATION_API_KEY=
